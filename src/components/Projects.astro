---
import { getData, type Lang } from '../i18n/index';

const { lang = 'es' } = Astro.props;
const data = getData(lang as Lang);
---
<section id="projects" class="py-24 md:py-32 px-6">
  <div class="max-w-3xl mx-auto">
    <!-- Section heading -->
    <div class="animate-on-scroll mb-16">
      <p class="text-xs font-display tracking-[0.3em] uppercase mb-3 text-[var(--color-accent)]">03</p>
      <h2
        class="text-3xl md:text-4xl font-display font-bold mb-4
               text-[var(--color-text-light-primary)] dark:text-[var(--color-text-dark-primary)]"
        data-i18n="sections.projects"
      >
        {data.sections.projects}
      </h2>
      <div class="w-16 h-[1.5px] bg-[var(--color-accent)]"></div>
    </div>

    <!-- Timeline -->
    {data.projects.map((project, idx) => (
      <div class="animate-on-scroll timeline-line pl-8 pb-12 last:pb-0">
        <!-- Dot -->
        <div class="absolute left-[7px] -translate-x-1/2 top-1 w-[20px] h-[20px] rounded-full
                    border-2 border-[var(--color-accent)]
                    bg-[var(--color-surface-light)] dark:bg-[var(--color-surface-dark)]  text-[var(--color-text-light-primary)] dark:text-[var(--color-text-dark-primary)] text-xs font-mono flex justify-center items-center">
          {idx+1}
        </div>

{/*         <!-- Date & Location -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mb-2">
          <span class="text-xs font-display tracking-wider uppercase text-[var(--color-accent)]">
            <span data-i18n-proj={String(idx)} data-i18n-field="startDate">{project.startDate}</span>
            {' — '}
            <span data-i18n-proj={String(idx)} data-i18n-field="endDate">{project.endDate}</span>
          </span>
          <span class="text-xs text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]"
                data-i18n-proj={String(idx)} data-i18n-field="location">
            {project.location}
          </span>
        </div> */}

        <!-- Project -->
        <h3 class="text-lg md:text-xl font-display font-semibold mb-1
                  text-[var(--color-text-light-primary)] dark:text-[var(--color-text-dark-primary)]">
          <span data-i18n-proj={String(idx)} data-i18n-field="name">{project.name}</span>
          <span class="mx-1 font-light">-</span>
          <span class="text-xs font-display font-thin tracking-wider  text-[var(--color-accent)]"
                data-i18n-proj={String(idx)} data-i18n-field="type">
            ({project.type})
          </span>
        </h3>
        <p class="text-sm font-body mb-4
                  text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]"
          data-i18n-proj={String(idx)} data-i18n-field="summary">
          {project.summary}
        </p>

        <!-- Highlights -->
        <ul class="space-y-2 mb-6">
          {project.highlights.map((hl, hlIdx) => (
            <li class="flex items-start gap-3 text-sm font-body
                      text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]">
              <svg class="w-3 h-3 self-center flex-shrink-0 text-[var(--color-accent)]" viewBox="0 0 24 24"><path fill="currentColor" d="M12 22q-2.075 0-3.9-.788t-3.175-2.137T2.788 15.9 2 12t.788-3.9 2.137-3.175T8.1 2.788 12 2t3.9.788 3.175 2.137T21.213 8.1 22 12t-.788 3.9-2.137 3.175-3.175 2.138T12 22"/></svg>
              <span data-i18n-proj-hl={`${idx},${hlIdx}`}>{hl}</span>
            </li>
          ))}
        </ul>

        <!-- Carousel -->
        {project.images && project.images.length > 0 && (
          <div class="carousel sm:max-w-[80%] sm:mx-auto" data-carousel>
            <div class="carousel-wrapper">
            <div class="carousel-viewport">
              {project.images.map((img, imgIdx) => (
                <div class="carousel-slide">
                  <img
                    src={img.src}
                    alt={img.alt}
                    loading="lazy"
                    class="carousel-image"
                  />
                </div>
              ))}
            </div>

            <!-- Prev button -->
            <button
              type="button"
              class="carousel-btn carousel-btn-prev"
              aria-label="Previous image"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6" />
              </svg>
            </button>

            <!-- Next button -->
            <button
              type="button"
              class="carousel-btn carousel-btn-next"
              aria-label="Next image"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </button>
          </div>

            <!-- Dots -->
            <div class="carousel-dots">
              {project.images.map((_, dotIdx) => (
                <button
                  type="button"
                  class:list={['carousel-dot', { active: dotIdx === 0 }]}
                  aria-label={`Go to image ${dotIdx + 1}`}
                  data-dot-index={String(dotIdx)}
                />
              ))}
            </div>

            <!-- Counter -->
            <p class="carousel-counter">
              <span class="carousel-counter-current">1</span>
              {' / '}
              <span class="carousel-counter-total">{project.images.length}</span>
            </p>
          </div>
        )}
      </div>
    ))}
  </div>

  <!-- Section divider -->
  <div class="max-w-3xl mx-auto mt-16">
    <svg class="section-divider w-full h-[1px]" viewBox="0 0 800 1" preserveAspectRatio="none">
      <line x1="0" y1="0.5" x2="800" y2="0.5" stroke="var(--color-accent)" stroke-width="0.5" opacity="0.2" />
    </svg>
  </div>
</section>

<script is:inline>
(function () {
  document.querySelectorAll('[data-carousel]').forEach(function (carousel) {
    var viewport = carousel.querySelector('.carousel-viewport');
    var slides = carousel.querySelectorAll('.carousel-slide');
    var dots = carousel.querySelectorAll('.carousel-dot');
    var counterCurrent = carousel.querySelector('.carousel-counter-current');
    var prevBtn = carousel.querySelector('.carousel-btn-prev');
    var nextBtn = carousel.querySelector('.carousel-btn-next');
    var total = slides.length;
    var current = 0;
    var currentDotIdx = 0;
    var isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var slideWidth = slides[0] ? slides[0].offsetWidth : 0;
    var scrollTicking = false;

    // Recache slide width on resize
    window.addEventListener('resize', function () {
      slideWidth = slides[0] ? slides[0].offsetWidth : 0;
    });

    function goTo(index) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      current = index;
      viewport.scrollTo({
        left: slides[current].offsetLeft,
        behavior: isReduced ? 'auto' : 'smooth'
      });
      dots[currentDotIdx].classList.remove('active');
      dots[current].classList.add('active');
      currentDotIdx = current;
      if (counterCurrent) counterCurrent.textContent = current + 1;
    }

    prevBtn.addEventListener('click', function () { goTo(current - 1); });
    nextBtn.addEventListener('click', function () { goTo(current + 1); });
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        goTo(parseInt(dot.getAttribute('data-dot-index')));
      });
    });

    // Sync dot state on native scroll (rAF-throttled)
    viewport.addEventListener('scroll', function () {
      if (scrollTicking) return;
      scrollTicking = true;
      requestAnimationFrame(function () {
        if (slideWidth === 0) { scrollTicking = false; return; }
        var idx = Math.round(viewport.scrollLeft / slideWidth);
        if (idx !== current && idx >= 0 && idx < total) {
          dots[currentDotIdx].classList.remove('active');
          current = idx;
          dots[current].classList.add('active');
          currentDotIdx = current;
          if (counterCurrent) counterCurrent.textContent = current + 1;
        }
        scrollTicking = false;
      });
    }, { passive: true });

    // Keyboard navigation
    carousel.setAttribute('tabindex', '0');
    carousel.setAttribute('role', 'region');
    carousel.setAttribute('aria-label', 'Project image gallery');
    carousel.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(current - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current + 1); }
    });

    // Touch / swipe support
    var startX = 0;
    var threshold = 40;
    viewport.addEventListener('touchstart', function (e) {
      startX = e.changedTouches[0].screenX;
    }, { passive: true });
    viewport.addEventListener('touchend', function (e) {
      var diff = startX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > threshold) {
        if (diff > 0) goTo(current + 1);
        else goTo(current - 1);
      }
    }, { passive: true });
  });
})();
</script>