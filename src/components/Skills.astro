---
import esData from '../i18n/es.json';

const data = esData;
---

<section id="skills" class="py-24 md:py-32 px-6">
  <div class="max-w-3xl mx-auto">
    <!-- Section heading -->
    <div class="animate-on-scroll mb-16">
      <p class="text-xs font-display tracking-[0.3em] uppercase mb-3 text-[var(--color-accent)]">04</p>
      <h2
        class="text-3xl md:text-4xl font-display font-bold mb-4
               text-[var(--color-text-light-primary)] dark:text-[var(--color-text-dark-primary)]"
        data-i18n="sections.skills"
      >
        {data.sections.skills}
      </h2>
      <div class="w-16 h-[1.5px] bg-[var(--color-accent)]"></div>
    </div>

    <!-- Skills grid -->
    <div class="stagger-children grid grid-cols-1 md:grid-cols-2 gap-5">
      {data.skills.map((skill, idx) => (
        <div
          class="skill-card group p-5 rounded-lg
                 bg-[var(--color-surface-light-secondary)] dark:bg-[var(--color-surface-dark-secondary)]
                 border border-transparent
                 hover:border-[var(--color-accent)]/20"
        >
          <!-- Label with icon -->
          <div class="flex items-center gap-3 mb-3">
            <div class="w-8 h-8 rounded-md flex items-center justify-center
                        bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
              {/* 0: Programming Languages — code brackets */}
              {idx === 0 && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="16 18 22 12 16 6" />
                  <polyline points="8 6 2 12 8 18" />
                </svg>
              )}
              {/* 1: Databases — cylinder */}
              {idx === 1 && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <ellipse cx="12" cy="5" rx="9" ry="3" />
                  <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                  <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                </svg>
              )}
              {/* 2: Frameworks & Libraries — modules/grid */}
              {idx === 2 && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7" />
                  <rect x="14" y="3" width="7" height="7" />
                  <rect x="14" y="14" width="7" height="7" />
                  <rect x="3" y="14" width="7" height="7" />
                </svg>
              )}
              {/* 3: Infrastructure & DevOps — server */}
              {idx === 3 && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="8" rx="2" ry="2" />
                  <rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
                  <line x1="6" y1="6" x2="6.01" y2="6" />
                  <line x1="6" y1="18" x2="6.01" y2="18" />
                </svg>
              )}
              {/* 4: Artificial Intelligence — cpu/chip */}
              {idx === 4 && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="9" y="9" width="6" height="6" />
                  <path d="M9 3H15" />
                  <path d="M9 21H15" />
                  <path d="M3 9V15" />
                  <path d="M21 9V15" />
                  <path d="M9 3V1" />
                  <path d="M15 3V1" />
                  <path d="M9 23V21" />
                  <path d="M15 23V21" />
                  <path d="M1 9H3" />
                  <path d="M1 15H3" />
                  <path d="M21 9H23" />
                  <path d="M21 15H23" />
                  <rect x="5" y="5" width="14" height="14" rx="1" />
                </svg>
              )}
              {/* 5: Office & Tools — document */}
              {idx === 5 && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="16" y1="13" x2="8" y2="13" />
                  <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
              )}
              {/* 6: Languages — globe */}
              {idx === 6 && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="2" y1="12" x2="22" y2="12" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
              )}
              {/* 7: Interpersonal Skills — people/users */}
              {idx === 7 && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
              )}
            </div>
            <h3
              class="text-sm font-display font-semibold uppercase tracking-wider
                     text-[var(--color-text-light-primary)] dark:text-[var(--color-text-dark-primary)]"
              data-i18n-skill={String(idx)} data-i18n-field="label"
            >
              {skill.label}
            </h3>
          </div>

          <!-- Details -->
          <p
            class="text-sm font-body leading-relaxed
                   text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]"
            data-i18n-skill={String(idx)} data-i18n-field="details"
          >
            {skill.details}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- Section divider -->
  <div class="max-w-3xl mx-auto mt-16">
    <svg class="section-divider w-full h-[1px]" viewBox="0 0 800 1" preserveAspectRatio="none">
      <line x1="0" y1="0.5" x2="800" y2="0.5" stroke="var(--color-accent)" stroke-width="0.5" opacity="0.2" />
    </svg>
  </div>
</section>
