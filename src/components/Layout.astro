---
import "../styles/global.css";
import esData from "../i18n/es.json";
import enData from "../i18n/en.json";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Abraham P. | Portfolio",
  description = "Professional portfolio",
} = Astro.props;
const siteUrl = "https://abrahamkuk.dev";

// Pre-serialize i18n data as minified JSON strings to reduce inline script payload
const esJson = JSON.stringify(esData);
const enJson = JSON.stringify(enData);
---

<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/c:\Users\asa\Downloads\icon.svgicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" id="meta-description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Theme color -->
    <meta
      name="theme-color"
      content="#0a0a0a"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#fafaf9"
      media="(prefers-color-scheme: light)"
    />

    <!-- OG / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" id="og-description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:locale:alternate" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      id="twitter-description"
      content={description}
    />

    <link rel="canonical" href={siteUrl} />

    <!-- Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts: non-blocking load (preload + media swap trick) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap"
      />
    </noscript>

    <!-- Anti-FOUC: Apply theme before render -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
        } catch (e) {
          var stored = null;
        }
        if (stored === "light") {
          document.documentElement.classList.remove("dark");
        } else if (stored === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          if (window.matchMedia("(prefers-color-scheme: light)").matches) {
            document.documentElement.classList.remove("dark");
          } else {
            document.documentElement.classList.add("dark");
          }
        }
      })();
    </script>

    <!-- Anti-FOUC: Apply saved language before render -->
    <script is:inline>
      (function () {
        try {
          var lang = localStorage.getItem("lang");
        } catch (e) {
          var lang = null;
        }
        if (lang === "en") {
          document.documentElement.lang = "en";
        }
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <!-- Skip to content (accessibility) -->
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    <!-- i18n data embedded for client-side switching -->
    <script is:inline define:vars={{ esJson, enJson }}>
      window.__i18n = { es: JSON.parse(esJson), en: JSON.parse(enJson) };
      try {
        window.__lang = localStorage.getItem("lang") || "es";
      } catch (e) {
        window.__lang = "es";
      }
    </script>

    <slot />

    <!-- i18n engine -->
    <script is:inline>
      (function () {
        function applyLang(lang) {
          var data = window.__i18n[lang];
          if (!data) return;
          window.__lang = lang;
          try {
            localStorage.setItem("lang", lang);
          } catch (e) {}
          document.documentElement.lang = lang;

          // Update all elements with data-i18n
          document.querySelectorAll("[data-i18n]").forEach(function (el) {
            var key = el.getAttribute("data-i18n");
            var val = key.split(".").reduce(function (o, k) {
              return o && o[k];
            }, data);
            if (val !== undefined && val !== null) {
              el.textContent = val;
            }
          });

          // Update dynamic lists (experience, education, skills, activities)
          // Experience
          document.querySelectorAll("[data-i18n-exp]").forEach(function (el) {
            var idx = parseInt(el.getAttribute("data-i18n-exp"));
            var field = el.getAttribute("data-i18n-field");
            var exp = data.experience[idx];
            if (exp && field && exp[field] !== undefined) {
              el.textContent = exp[field];
            }
          });

          // Experience highlights
          document
            .querySelectorAll("[data-i18n-exp-hl]")
            .forEach(function (el) {
              var parts = el.getAttribute("data-i18n-exp-hl").split(",");
              var expIdx = parseInt(parts[0]);
              var hlIdx = parseInt(parts[1]);
              var exp = data.experience[expIdx];
              if (
                exp &&
                exp.highlights &&
                exp.highlights[hlIdx] !== undefined
              ) {
                el.textContent = exp.highlights[hlIdx];
              }
            });

          // Education
          document.querySelectorAll("[data-i18n-edu]").forEach(function (el) {
            var idx = parseInt(el.getAttribute("data-i18n-edu"));
            var field = el.getAttribute("data-i18n-field");
            var edu = data.education[idx];
            if (edu && field && edu[field] !== undefined) {
              el.textContent = edu[field];
            }
          });

          // Education highlights
          document
            .querySelectorAll("[data-i18n-edu-hl]")
            .forEach(function (el) {
              var parts = el.getAttribute("data-i18n-edu-hl").split(",");
              var eduIdx = parseInt(parts[0]);
              var hlIdx = parseInt(parts[1]);
              var edu = data.education[eduIdx];
              if (
                edu &&
                edu.highlights &&
                edu.highlights[hlIdx] !== undefined
              ) {
                el.textContent = edu.highlights[hlIdx];
              }
            });

          // Skills
          document.querySelectorAll("[data-i18n-skill]").forEach(function (el) {
            var idx = parseInt(el.getAttribute("data-i18n-skill"));
            var field = el.getAttribute("data-i18n-field");
            var skill = data.skills[idx];
            if (skill && field && skill[field] !== undefined) {
              el.textContent = skill[field];
            }
          });

          // Activities
          document
            .querySelectorAll("[data-i18n-activity]")
            .forEach(function (el) {
              var idx = parseInt(el.getAttribute("data-i18n-activity"));
              if (data.activities[idx] !== undefined) {
                el.textContent = data.activities[idx];
              }
            });

          // Update toggle button text
          var toggleBtn = document.getElementById("lang-toggle-text");
          if (toggleBtn) {
            toggleBtn.textContent = data.lang.toggle;
          }

          // Update meta title & description
          document.title = data.meta.title;
          var desc = data.meta.description || "";
          var metaDesc = document.getElementById("meta-description");
          var ogDesc = document.getElementById("og-description");
          var twDesc = document.getElementById("twitter-description");
          if (metaDesc) metaDesc.setAttribute("content", desc);
          if (ogDesc) ogDesc.setAttribute("content", desc);
          if (twDesc) twDesc.setAttribute("content", desc);
        }

        // Apply on load
        applyLang(window.__lang);

        // Listen for language change
        window.addEventListener("langChange", function (e) {
          applyLang(e.detail.lang);
        });
      })();
    </script>

    <!-- Scroll animations (includes section dividers) -->
    <script is:inline>
      (function () {
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
        );

        document
          .querySelectorAll(
            ".animate-on-scroll, .stagger-children, .section-divider",
          )
          .forEach(function (el) {
            observer.observe(el);
          });
      })();
    </script>
  </body>
</html>
