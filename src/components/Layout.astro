---
import "../styles/global.css";
import esData from "../i18n/es.json";
import enData from "../i18n/en.json";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import { getData, type Lang } from "../i18n/index";

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const {
  lang = "es",
  title,
  description,
} = Astro.props;

const data = getData(lang);
const resolvedTitle = title || data.meta.title;
const resolvedDescription = description || data.meta.description;
const siteUrl = "https://portfolio-abrahampuch.vercel.app/";

// Pre-serialize i18n data as minified JSON strings to reduce inline script payload
const esJson = JSON.stringify(esData);
const enJson = JSON.stringify(enData);
---

<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/icon-v1.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" id="meta-description" content={resolvedDescription} />
    <meta name="generator" content={Astro.generator} />
    <title>{resolvedTitle}</title>

    <!-- Theme color -->
    <meta
      name="theme-color"
      content="#0a0a0a"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#fafaf9"
      media="(prefers-color-scheme: light)"
    />

    <!-- OG / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" id="og-description" content={resolvedDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:locale:alternate" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta
      name="twitter:description"
      id="twitter-description"
      content={resolvedDescription}
    />

    <link rel="canonical" href={siteUrl} />

    <!-- hreflang alternate links -->
    <link rel="alternate" hreflang="es" href={siteUrl} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}?lang=en`} />
    <link rel="alternate" hreflang="x-default" href={siteUrl} />

    <!-- Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts: non-blocking load (preload + media swap trick) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap"
      />
    </noscript>

    <!-- Anti-FOUC: Apply theme before render -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
        } catch (e) {
          var stored = null;
        }
        if (stored === "light") {
          document.documentElement.classList.remove("dark");
        } else if (stored === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          if (window.matchMedia("(prefers-color-scheme: light)").matches) {
            document.documentElement.classList.remove("dark");
          } else {
            document.documentElement.classList.add("dark");
          }
        }
      })();
    </script>

    <!-- Anti-FOUC: Apply saved language before render -->
    <script is:inline define:vars={{ defaultLang: lang }}>
      (function () {
        var lang = defaultLang;
        try {
          var stored = localStorage.getItem("lang");
          if (stored === "en" || stored === "es") lang = stored;
        } catch (e) {}
        if (lang === "en") {
          document.documentElement.lang = "en";
        }
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <!-- Skip to content (accessibility) -->
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    <SpeedInsights />
    <Analytics />

    <!-- i18n data embedded for client-side switching -->
    <script is:inline define:vars={{ esJson, enJson, defaultLang: lang }}>
      // Only parse the initial language immediately; defer the other
      var __i18nData = {};
      var __esJson = esJson;
      var __enJson = enJson;
      var __initLang = "es";
      try {
        var stored = localStorage.getItem("lang");
        if (stored === "en" || stored === "es") __initLang = stored;
      } catch (e) {}
      __i18nData[__initLang] = JSON.parse(__initLang === "en" ? __enJson : __esJson);
      window.__lang = __initLang;

      function getI18n(lang) {
        if (!__i18nData[lang]) {
          __i18nData[lang] = JSON.parse(lang === "en" ? __enJson : __esJson);
        }
        return __i18nData[lang];
      }
      window.getI18n = getI18n;
    </script>

    <slot />

    <!-- i18n engine (cached DOM refs, lazy-parse) -->
    <script is:inline>
      (function () {
        // Cache all i18n elements + parse metadata once on init
        var i18nEls = [];
        var expEls = [];
        var expHlEls = [];
        var eduEls = [];
        var eduHlEls = [];
        var projEls = [];
        var projHlEls = [];
        var skillEls = [];
        var activityEls = [];
        var toggleBtn = document.getElementById("lang-toggle-text");
        var metaDesc = document.getElementById("meta-description");
        var ogDesc = document.getElementById("og-description");
        var twDesc = document.getElementById("twitter-description");

        document.querySelectorAll("[data-i18n]").forEach(function (el) {
          i18nEls.push({ el: el, key: el.getAttribute("data-i18n") });
        });
        document.querySelectorAll("[data-i18n-exp]").forEach(function (el) {
          expEls.push({ el: el, idx: parseInt(el.getAttribute("data-i18n-exp")), field: el.getAttribute("data-i18n-field") });
        });
        document.querySelectorAll("[data-i18n-exp-hl]").forEach(function (el) {
          var parts = el.getAttribute("data-i18n-exp-hl").split(",");
          expHlEls.push({ el: el, expIdx: parseInt(parts[0]), hlIdx: parseInt(parts[1]) });
        });
        document.querySelectorAll("[data-i18n-edu]").forEach(function (el) {
          eduEls.push({ el: el, idx: parseInt(el.getAttribute("data-i18n-edu")), field: el.getAttribute("data-i18n-field") });
        });
        document.querySelectorAll("[data-i18n-edu-hl]").forEach(function (el) {
          var parts = el.getAttribute("data-i18n-edu-hl").split(",");
          eduHlEls.push({ el: el, eduIdx: parseInt(parts[0]), hlIdx: parseInt(parts[1]) });
        });
        document.querySelectorAll("[data-i18n-proj]").forEach(function (el) {
          projEls.push({ el: el, idx: parseInt(el.getAttribute("data-i18n-proj")), field: el.getAttribute("data-i18n-field") });
        });
        document.querySelectorAll("[data-i18n-proj-hl]").forEach(function (el) {
          var parts = el.getAttribute("data-i18n-proj-hl").split(",");
          projHlEls.push({ el: el, projIdx: parseInt(parts[0]), hlIdx: parseInt(parts[1]) });
        });
        document.querySelectorAll("[data-i18n-skill]").forEach(function (el) {
          skillEls.push({ el: el, idx: parseInt(el.getAttribute("data-i18n-skill")), field: el.getAttribute("data-i18n-field") });
        });
        document.querySelectorAll("[data-i18n-activity]").forEach(function (el) {
          activityEls.push({ el: el, idx: parseInt(el.getAttribute("data-i18n-activity")) });
        });

        function applyLang(lang) {
          var data = window.getI18n(lang);
          if (!data) return;
          window.__lang = lang;
          try { localStorage.setItem("lang", lang); } catch (e) {}
          document.documentElement.lang = lang;

          var i, item;
          for (i = 0; i < i18nEls.length; i++) {
            item = i18nEls[i];
            var val = item.key.split(".").reduce(function (o, k) { return o && o[k]; }, data);
            if (val != null) item.el.textContent = val;
          }
          for (i = 0; i < expEls.length; i++) {
            item = expEls[i];
            var exp = data.experience[item.idx];
            if (exp && exp[item.field] != null) item.el.textContent = exp[item.field];
          }
          for (i = 0; i < expHlEls.length; i++) {
            item = expHlEls[i];
            var ex = data.experience[item.expIdx];
            if (ex && ex.highlights && ex.highlights[item.hlIdx] != null) item.el.textContent = ex.highlights[item.hlIdx];
          }
          for (i = 0; i < eduEls.length; i++) {
            item = eduEls[i];
            var edu = data.education[item.idx];
            if (edu && edu[item.field] != null) item.el.textContent = edu[item.field];
          }
          for (i = 0; i < eduHlEls.length; i++) {
            item = eduHlEls[i];
            var ed = data.education[item.eduIdx];
            if (ed && ed.highlights && ed.highlights[item.hlIdx] != null) item.el.textContent = ed.highlights[item.hlIdx];
          }
          for (i = 0; i < projEls.length; i++) {
            item = projEls[i];
            var proj = data.projects[item.idx];
            if (proj && proj[item.field] != null) item.el.textContent = proj[item.field];
          }
          for (i = 0; i < projHlEls.length; i++) {
            item = projHlEls[i];
            var p = data.projects[item.projIdx];
            if (p && p.highlights && p.highlights[item.hlIdx] != null) item.el.textContent = p.highlights[item.hlIdx];
          }
          for (i = 0; i < skillEls.length; i++) {
            item = skillEls[i];
            var skill = data.skills[item.idx];
            if (skill && skill[item.field] != null) item.el.textContent = skill[item.field];
          }
          for (i = 0; i < activityEls.length; i++) {
            item = activityEls[i];
            if (data.activities[item.idx] != null) item.el.textContent = data.activities[item.idx];
          }

          if (toggleBtn) toggleBtn.textContent = data.lang.toggle;
          document.title = data.meta.title;
          var desc = data.meta.description || "";
          if (metaDesc) metaDesc.setAttribute("content", desc);
          if (ogDesc) ogDesc.setAttribute("content", desc);
          if (twDesc) twDesc.setAttribute("content", desc);
        }

        applyLang(window.__lang);
        window.addEventListener("langChange", function (e) {
          applyLang(e.detail.lang);
        });
      })();
    </script>

    <!-- Phone obfuscation handler -->
    <script is:inline>
      document.querySelectorAll("[data-tel]").forEach(function (el) {
        el.addEventListener("click", function (e) {
          e.preventDefault();
          var tel = el.getAttribute("data-tel");
          window.location.href = "tel:" + tel;
        });
      });
    </script>

    <!-- Scroll animations (includes section dividers) -->
    <script is:inline>
      (function () {
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
        );

        document
          .querySelectorAll(
            ".animate-on-scroll, .stagger-children, .section-divider",
          )
          .forEach(function (el) {
            observer.observe(el);
          });
      })();
    </script>
  </body>
</html>
