---
// SVGBackground.astro - Animated constellation-like geometric SVG
---

<div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
  <svg
    class="w-full h-full opacity-[0.15] dark:opacity-[0.12]"
    viewBox="0 0 1200 800"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
    role="presentation"
  >
    <defs>
      <radialGradient id="svg-bg-dot-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.8" />
        <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Connecting lines (stroke-dasharray matches computed line length) -->
    <g class="constellation-lines" stroke="var(--color-accent)" stroke-width="0.5" opacity="0.3">
      <!-- Row 1: top constellation -->
      <line x1="100" y1="120" x2="280" y2="200" stroke-dasharray="197" style="animation: line-extend 2s ease-out 0.2s forwards; opacity: 0;" />
      <line x1="280" y1="200" x2="450" y2="140" stroke-dasharray="180" style="animation: line-extend 2s ease-out 0.5s forwards; opacity: 0;" />
      <line x1="450" y1="140" x2="620" y2="260" stroke-dasharray="206" style="animation: line-extend 2s ease-out 0.8s forwards; opacity: 0;" />
      <line x1="620" y1="260" x2="800" y2="180" stroke-dasharray="196" style="animation: line-extend 2s ease-out 1.1s forwards; opacity: 0;" />
      <line x1="800" y1="180" x2="980" y2="300" stroke-dasharray="213" style="animation: line-extend 2s ease-out 1.4s forwards; opacity: 0;" />
      <line x1="980" y1="300" x2="1100" y2="220" stroke-dasharray="145" style="animation: line-extend 2s ease-out 1.7s forwards; opacity: 0;" />

      <!-- Row 2: mid constellation -->
      <line x1="150" y1="400" x2="340" y2="480" stroke-dasharray="206" style="animation: line-extend 2s ease-out 0.4s forwards; opacity: 0;" />
      <line x1="340" y1="480" x2="520" y2="380" stroke-dasharray="206" style="animation: line-extend 2s ease-out 0.7s forwards; opacity: 0;" />
      <line x1="520" y1="380" x2="700" y2="500" stroke-dasharray="213" style="animation: line-extend 2s ease-out 1.0s forwards; opacity: 0;" />
      <line x1="700" y1="500" x2="880" y2="420" stroke-dasharray="196" style="animation: line-extend 2s ease-out 1.3s forwards; opacity: 0;" />
      <line x1="880" y1="420" x2="1050" y2="540" stroke-dasharray="201" style="animation: line-extend 2s ease-out 1.6s forwards; opacity: 0;" />

      <!-- Cross connections -->
      <line x1="280" y1="200" x2="340" y2="480" stroke-dasharray="287" style="animation: line-extend 2.5s ease-out 1.0s forwards; opacity: 0;" />
      <line x1="620" y1="260" x2="520" y2="380" stroke-dasharray="152" style="animation: line-extend 2.5s ease-out 1.2s forwards; opacity: 0;" />
      <line x1="800" y1="180" x2="880" y2="420" stroke-dasharray="253" style="animation: line-extend 2.5s ease-out 1.4s forwards; opacity: 0;" />
      <line x1="450" y1="140" x2="520" y2="380" stroke-dasharray="249" style="animation: line-extend 2.5s ease-out 1.6s forwards; opacity: 0;" />

      <!-- Lower constellation -->
      <line x1="200" y1="620" x2="400" y2="680" stroke-dasharray="211" style="animation: line-extend 2s ease-out 1.0s forwards; opacity: 0;" />
      <line x1="400" y1="680" x2="600" y2="600" stroke-dasharray="216" style="animation: line-extend 2s ease-out 1.3s forwards; opacity: 0;" />
      <line x1="600" y1="600" x2="850" y2="700" stroke-dasharray="265" style="animation: line-extend 2s ease-out 1.6s forwards; opacity: 0;" />
      <line x1="850" y1="700" x2="1000" y2="620" stroke-dasharray="170" style="animation: line-extend 2s ease-out 1.9s forwards; opacity: 0;" />

      <!-- Vertical bridges -->
      <line x1="150" y1="400" x2="200" y2="620" stroke-dasharray="226" style="animation: line-extend 2.5s ease-out 1.5s forwards; opacity: 0;" />
      <line x1="700" y1="500" x2="600" y2="600" stroke-dasharray="141" style="animation: line-extend 2.5s ease-out 1.8s forwards; opacity: 0;" />
    </g>

    <!-- Constellation dots (nodes) — no drift to keep aligned with lines -->
    <g class="constellation-dots">
      <!-- Row 1 -->
      <circle cx="100" cy="120" r="3" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 0s infinite;" />
      <circle cx="280" cy="200" r="4" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 0.4s infinite;" />
      <circle cx="450" cy="140" r="2.5" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 0.8s infinite;" />
      <circle cx="620" cy="260" r="3.5" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 1.2s infinite;" />
      <circle cx="800" cy="180" r="3" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 1.6s infinite;" />
      <circle cx="980" cy="300" r="4" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 2.0s infinite;" />
      <circle cx="1100" cy="220" r="2.5" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 2.4s infinite;" />

      <!-- Row 2 -->
      <circle cx="150" cy="400" r="3.5" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 0.3s infinite;" />
      <circle cx="340" cy="480" r="3" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 0.7s infinite;" />
      <circle cx="520" cy="380" r="4" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 1.1s infinite;" />
      <circle cx="700" cy="500" r="2.5" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 1.5s infinite;" />
      <circle cx="880" cy="420" r="3" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 1.9s infinite;" />
      <circle cx="1050" cy="540" r="3.5" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 2.3s infinite;" />

      <!-- Row 3 -->
      <circle cx="200" cy="620" r="3" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 0.5s infinite;" />
      <circle cx="400" cy="680" r="4" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 0.9s infinite;" />
      <circle cx="600" cy="600" r="2.5" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 1.3s infinite;" />
      <circle cx="850" cy="700" r="3.5" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 1.7s infinite;" />
      <circle cx="1000" cy="620" r="3" fill="var(--color-accent)" style="animation: pulse-dot 3s ease-in-out 2.1s infinite;" />

      <!-- Accent glow dots (larger, subtle) -->
      <circle cx="280" cy="200" r="12" fill="url(#svg-bg-dot-glow)" opacity="0.5" style="animation: pulse-dot 4s ease-in-out 0.4s infinite;" />
      <circle cx="520" cy="380" r="12" fill="url(#svg-bg-dot-glow)" opacity="0.5" style="animation: pulse-dot 4s ease-in-out 1.1s infinite;" />
      <circle cx="800" cy="180" r="12" fill="url(#svg-bg-dot-glow)" opacity="0.5" style="animation: pulse-dot 4s ease-in-out 1.6s infinite;" />
      <circle cx="400" cy="680" r="12" fill="url(#svg-bg-dot-glow)" opacity="0.5" style="animation: pulse-dot 4s ease-in-out 0.9s infinite;" />
    </g>

    <!-- Subtle geometric shapes -->
    <g opacity="0.08" stroke="var(--color-accent)" fill="none" stroke-width="0.5">
      <polygon points="280,200 450,140 520,380" style="animation: fadeIn 3s ease-out 2s forwards; opacity: 0;" />
      <polygon points="620,260 800,180 880,420" style="animation: fadeIn 3s ease-out 2.5s forwards; opacity: 0;" />
      <polygon points="340,480 520,380 600,600" style="animation: fadeIn 3s ease-out 3s forwards; opacity: 0;" />
    </g>
  </svg>
</div>
