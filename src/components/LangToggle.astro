---
// LangToggle.astro - ES/EN language switch button
---

<button
  id="lang-toggle"
  type="button"
  aria-label="Toggle language"
  class="flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-display font-semibold tracking-wider uppercase
         border border-[var(--color-accent)]/30
         text-[var(--color-accent)]
         transition-all duration-300
         hover:bg-[var(--color-accent)]/10
         hover:border-[var(--color-accent)]/60"
>
  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10" />
    <line x1="2" y1="12" x2="22" y2="12" />
    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
  </svg>
  <span id="lang-toggle-text">EN</span>
</button>

<script is:inline>
  (function() {
    var btn = document.getElementById('lang-toggle');
    if (!btn) return;

    btn.addEventListener('click', function() {
      var current = window.__lang || 'es';
      var next = current === 'es' ? 'en' : 'es';
      window.dispatchEvent(new CustomEvent('langChange', { detail: { lang: next } }));
      btn.setAttribute('aria-label', next === 'es' ? 'Switch to English' : 'Cambiar a Español');
    });

    // Set initial aria-label based on current language
    var initLang = window.__lang || 'es';
    btn.setAttribute('aria-label', initLang === 'es' ? 'Switch to English' : 'Cambiar a Español');
  })();
</script>
