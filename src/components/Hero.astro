---
import SVGBackground from "./SVGBackground.astro";
import { getData, type Lang } from "../i18n/index";

const { lang = "es" } = Astro.props;
const data = getData(lang as Lang);
const contact = data.contact;
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <SVGBackground />

  <!-- Gradient overlay -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent
              to-[var(--color-surface-light)] dark:to-[var(--color-surface-dark)]
              pointer-events-none z-[1]"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 max-w-3xl mx-auto px-6 text-center">
    <!-- Greeting -->
    <p
      class="text-sm md:text-base font-body tracking-widest uppercase mt-10 mb-4
             text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]"
      style="animation: hero-text-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;"
      data-i18n="hero.greeting"
    >
      {data.hero.greeting}
    </p>

    <!-- Name -->
    <h1
      class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-bold leading-tight mb-6
             text-[var(--color-text-light-primary)] dark:text-[var(--color-text-dark-primary)]"
      style="animation: hero-text-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;"
      data-i18n="hero.name"
    >
      {data.hero.name}
    </h1>

    <!-- Role -->
    <p
      class="text-lg md:text-xl font-body mb-2
             text-[var(--color-accent)]"
      style="animation: hero-text-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;"
      data-i18n="hero.role"
    >
      {data.hero.role}
    </p>

    <!-- Location -->
    <p
      class="text-sm md:text-base font-body flex items-center justify-center gap-2 mb-10
             text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]"
      style="animation: hero-text-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.8s both;"
    >
      <svg
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <span data-i18n="hero.location">{data.hero.location}</span>
    </p>

    <!-- Social links + CTA -->
    <div
      class="flex flex-wrap items-center justify-center gap-4"
      style="animation: hero-text-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1.0s both;"
    >
      <!-- CTA button -->
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-sm font-display font-semibold
               bg-[var(--color-accent)] text-[var(--color-surface-dark)]
               hover:brightness-110 transition-all duration-300
               shadow-[0_0_20px_rgba(200,164,78,0.15)]
               hover:shadow-[0_0_30px_rgba(200,164,78,0.3)]"
      >
        <span data-i18n="hero.cta">{data.hero.cta}</span>
        <svg
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <!-- GitHub -->
      <a
        href={contact.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="w-10 h-10 flex items-center justify-center rounded-full
               border border-[var(--color-text-light-secondary)]/20
               dark:border-[var(--color-text-dark-secondary)]/20
               text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]
               hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]
               transition-all duration-300"
      >
        <svg
          class="w-[18px] h-[18px]"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
      </a>

      <!-- LinkedIn -->
      <a
        href={contact.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="w-10 h-10 flex items-center justify-center rounded-full
               border border-[var(--color-text-light-secondary)]/20
               dark:border-[var(--color-text-dark-secondary)]/20
               text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]
               hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]
               transition-all duration-300"
      >
        <svg
          class="w-[18px] h-[18px]"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
      </a>

      <!-- Email -->
      <a
        href={`mailto:${contact.email}`}
        aria-label="Email"
        class="w-10 h-10 flex items-center justify-center rounded-full
               border border-[var(--color-text-light-secondary)]/20
               dark:border-[var(--color-text-dark-secondary)]/20
               text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]
               hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]
               transition-all duration-300"
      >
        <svg
          class="w-[18px] h-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
          ></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </a>
    </div>

    <!-- Scroll indicator -->
    <div
      class="mt-16 flex flex-col items-center gap-2
             text-[var(--color-text-light-secondary)]/40 dark:text-[var(--color-text-dark-secondary)]/40"
      style="animation: hero-text-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1.4s both;"
    >
      <div
        class="w-[1px] h-8 bg-current"
        style="animation: float 2s ease-in-out infinite;"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>
</section>
