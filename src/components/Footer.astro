---
import esData from "../i18n/es.json";

const data = esData;
const currentYear = new Date().getFullYear();
---

<section id="contact">
  <footer class="relative py-24 md:py-32 px-6 overflow-hidden">
    <!-- Subtle SVG decoration -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <svg
        class="absolute bottom-0 left-0 w-full h-32 opacity-[0.05]"
        viewBox="0 0 1200 128"
        preserveAspectRatio="none"
      >
        <defs>
          <linearGradient id="footer-grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0"
            ></stop>
            <stop offset="50%" stop-color="var(--color-accent)" stop-opacity="1"
            ></stop>
            <stop
              offset="100%"
              stop-color="var(--color-accent)"
              stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <line
          x1="0"
          y1="1"
          x2="1200"
          y2="1"
          stroke="url(#footer-grad)"
          stroke-width="1"></line>
        <!-- Decorative dots pattern -->
        <g fill="var(--color-accent)" opacity="0.5">
          <circle cx="100" cy="40" r="1.5"></circle>
          <circle cx="200" cy="60" r="1"></circle>
          <circle cx="300" cy="35" r="2"></circle>
          <circle cx="400" cy="80" r="1.5"></circle>
          <circle cx="500" cy="50" r="1"></circle>
          <circle cx="600" cy="70" r="2"></circle>
          <circle cx="700" cy="45" r="1.5"></circle>
          <circle cx="800" cy="90" r="1"></circle>
          <circle cx="900" cy="55" r="2"></circle>
          <circle cx="1000" cy="75" r="1.5"></circle>
          <circle cx="1100" cy="40" r="1"></circle>
        </g>
      </svg>
    </div>

    <div class="relative max-w-3xl mx-auto">
      <!-- Section heading -->
      <div class="animate-on-scroll mb-12">
        <p
          class="text-xs font-display tracking-[0.3em] uppercase mb-3 text-[var(--color-accent)]"
        >
          05
        </p>
        <h2
          class="text-3xl md:text-4xl font-display font-bold mb-4
               text-[var(--color-text-light-primary)] dark:text-[var(--color-text-dark-primary)]"
          data-i18n="sections.contact"
        >
          {data.sections.contact}
        </h2>
        <div class="w-16 h-[1.5px] bg-[var(--color-accent)]"></div>
      </div>

      <!-- Contact cards -->
      <div
        class="animate-on-scroll grid grid-cols-1 sm:grid-cols-3 gap-4 mb-16"
      >
        <!-- Email -->
        <a
          href="mailto:asael.kuk@gmail.com"
          class="group p-5 rounded-lg text-center
               bg-[var(--color-surface-light-secondary)] dark:bg-[var(--color-surface-dark-secondary)]
               border border-transparent hover:border-[var(--color-accent)]/20
               transition-all duration-300"
        >
          <svg
            class="w-5 h-5 mx-auto mb-3 text-[var(--color-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
            ></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <p
            class="text-xs font-body text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]
                  group-hover:text-[var(--color-accent)] transition-colors duration-300 break-all"
          >
            asael.kuk@gmail.com
          </p>
        </a>

        <!-- Phone -->
        <a
          href="tel:+529991374343"
          class="group p-5 rounded-lg text-center
               bg-[var(--color-surface-light-secondary)] dark:bg-[var(--color-surface-dark-secondary)]
               border border-transparent hover:border-[var(--color-accent)]/20
               transition-all duration-300"
        >
          <svg
            class="w-5 h-5 mx-auto mb-3 text-[var(--color-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path>
          </svg>
          <p
            class="text-xs font-body text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]
                  group-hover:text-[var(--color-accent)] transition-colors duration-300"
          >
            +52 999 137 4343
          </p>
        </a>

        <!-- Location (consistent styling with other cards) -->
        <div
          class="group p-5 rounded-lg text-center
               bg-[var(--color-surface-light-secondary)] dark:bg-[var(--color-surface-dark-secondary)]
               border border-transparent"
        >
          <svg
            class="w-5 h-5 mx-auto mb-3 text-[var(--color-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <p
            class="text-xs font-body text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]"
            data-i18n="hero.location"
          >
            {data.hero.location}
          </p>
        </div>
      </div>

      <!-- Social links -->
      <nav class="animate-on-scroll mb-16" aria-label="Social links">
        <div class="flex items-center justify-center gap-4">
          <a
            href="https://github.com/asaret-0"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="w-11 h-11 flex items-center justify-center rounded-full
                 border border-[var(--color-text-light-secondary)]/20
                 dark:border-[var(--color-text-dark-secondary)]/20
                 text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]
                 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]
                 hover:bg-[var(--color-accent)]/5
                 transition-all duration-300"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/abraham-kuk"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-11 h-11 flex items-center justify-center rounded-full
                 border border-[var(--color-text-light-secondary)]/20
                 dark:border-[var(--color-text-dark-secondary)]/20
                 text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]
                 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]
                 hover:bg-[var(--color-accent)]/5
                 transition-all duration-300"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <a
            href="mailto:asael.kuk@gmail.com"
            aria-label="Email"
            class="w-11 h-11 flex items-center justify-center rounded-full
                 border border-[var(--color-text-light-secondary)]/20
                 dark:border-[var(--color-text-dark-secondary)]/20
                 text-[var(--color-text-light-secondary)] dark:text-[var(--color-text-dark-secondary)]
                 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]
                 hover:bg-[var(--color-accent)]/5
                 transition-all duration-300"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </a>
        </div>
      </nav>

      <!-- Copyright -->
      <div class="text-center">
        <p
          class="text-xs font-body
                text-[var(--color-text-light-secondary)]/50 dark:text-[var(--color-text-dark-secondary)]/50"
        >
          &copy; {currentYear} Abraham Asael Puch Kuk. <span
            data-i18n="footer.copyright">{data.footer.copyright}</span
          >
        </p>
        <p
          class="text-[10px] font-body mt-1
                text-[var(--color-text-light-secondary)]/30 dark:text-[var(--color-text-dark-secondary)]/30"
        >
          <span data-i18n="footer.builtWith">{data.footer.builtWith}</span>
        </p>
      </div>
    </div>
  </footer>
</section>
